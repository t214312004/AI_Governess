    "test:blink": "node tools/blink-continuity-test.mjs",
    "test:gaze": "node tools/gaze-face-test.mjs",
    "test:speech": "node tools/speech-face-test.mjs",
    "test:expression": "node tools/expression-face-test.mjs",
    "test:brow": "node tools/brow-hairline-test.mjs",
    "test:head": "node tools/head-neck-test.mjs",
    "test:turn": "node tools/head-turn-test.mjs",
    "test:turn-blink": "node tools/head-turn-blink-test.mjs",
    "test:gesture": "node tools/gesture-g2a-test.mjs"
