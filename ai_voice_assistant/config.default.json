{
  "audio": {
    "input_sample_rate": 16000,
    "output_sample_rate": 24000,
    "input_block_size": 512,
    "output_block_size": 512
  },
  "vad": {
    "threshold": 0.5,
    "min_silence_duration_ms": 1500,
    "speech_pad_ms": 30,
    "command_timeout_seconds": 60
  },
  "whisper": {
    "backend": "local",
    "model_size": "small",
    "device": "cpu",
    "compute_type": "int8",
    "language": "zh",
    "initial_prompt": "以下是繁體中文語音內容的逐字稿。",
    "groq": {
      "api_key": "",
      "api_key_env": "GROQ_API_KEY",
      "model": "whisper-large-v3",
      "api_url": "https://api.groq.com/openai/v1/audio/transcriptions",
      "timeout_seconds": 30
    }
  },
  "wake_word": {
    "keywords_file": "keywords.txt",
    "model_dir": "models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01"
  },
  "semantic_chunker": {
    "split_punctuation": "。！？!?；;",
    "also_split": ""
  },
  "tts": {
    "backend": "edge",
    "voice": "zh-TW-HsiaoChenNeural",
    "rate": "+0%",
    "volume": "+0%",
    "bluemagpie": {
      "enabled": false,
      "mode": "worker",
      "worker_python": ".venv-bluemagpie/Scripts/python.exe",
      "worker_script": "tools/bluemagpie_tts_worker.py",
      "model_dir": "models/bluemagpie",
      "hf_repo": "OpenFormosa/BlueMagpie-TTS",
      "hf_token_env": "HF_TOKEN",
      "device": "cuda",
      "cfg_value": 2.8,
      "inference_timesteps": 9,
      "max_len": 2000,
      "retry_badcase": true,
      "seed": null,
      "fade_out_ms": 30,
      "tail_silence_ms": 220,
      "speaker_centroid_path": "",
      "prompt_text": "",
      "prompt_wav_path": "",
      "seed_retry_count": 5,
      "min_rms": 0.0005,
      "min_nonzero_ratio": 0.001,
      "warm_on_start": false,
      "request_timeout_seconds": 120,
      "output_sample_rate": 24000,
      "temp_dir": "logs/tts_tmp"
    }
  },
  "whisper_audio_archive": {
    "enabled": false,
    "directory": "whisper_audio_archive",
    "write_transcript_sidecar": false
  },
  "speaker_recognition": {
    "enabled": true,
    "profile_dir": "voice_profiles",
    "threshold": 0.83,
    "min_duration_seconds": 2.0,
    "min_score_margin": 0.013
  },
  "presence_detection": {
    "enabled": true,
    "ttl_seconds": 300.0,
    "audio_triggers_presence": true,
    "input_triggers_presence": true
  },
  "hot_listen": {
    "enabled": true,
    "timeout_seconds": 10.0
  },
  "llm": {
    "active_backend": "antigravity_cli",
    "response_timeout_seconds": 120,
    "first_token_timeout_seconds": 90,
    "stream_idle_timeout_seconds": 150,
    "session_timeout_minutes": 10,
    "failure_window_seconds": 180,
    "failure_threshold": 3,
    "circuit_cooldown_seconds": 120,
    "openclaw": {
      "api_url": "http://localhost:18789/v1/responses",
      "token": "",
      "agent_id": "",
      "user": "voice-assistant",
      "model": "openclaw",
      "message_channel": "",
      "scopes": "",
      "request_timeout_seconds": 60
    },
    "claude_code": {
      "model": "sonnet",
      "max_turns": 3,
      "project_dir": "./agent_workspace",
      "permission_mode": "",
      "allowed_tools": "",
      "tools": "default"
    },
    "codex_cli": {
      "project_dir": "./agent_workspace",
      "model": "",
      "reasoning_effort": "low",
      "personality": "friendly",
      "sandbox": "workspace-write",
      "approval_policy": "on-request"
    },
    "opencode_cli": {
      "project_dir": "./agent_workspace",
      "model": "",
      "mode": "",
      "permission_mode": "yolo",
      "auto_approve": true,
      "use_runtime_config_content": true,
      "enable_web_search": true,
      "required_context_files": [
        "AGENTS.md"
      ],
      "instruction_files": [
        "MEMORY.md"
      ],
      "shell": ""
    },
    "antigravity_cli": {
      "project_dir": "./agent_workspace",
      "print_timeout": ""
    }
  },
  "user_activity_prompt": {
    "enabled": false,
    "text": "請問有什麼事嗎？",
    "mouse_move_threshold_px": 12,
    "require_foreground": true
  },
  "heartbeat": {
    "enabled": false,
    "interval_minutes": 20
  },
  "schedule": {
    "enabled": true,
    "max_due_jobs_per_heartbeat": 1,
    "state_dir": "schedule_state",
    "tool_path": "agent_workspace/tools/schedule_tool.py",
    "tool_payload_dir": "agent_workspace/tool_payloads/schedule",
    "claim_timeout_seconds": 600,
    "pending_report_availability_per_prompt": 2,
    "pending_report_bodies_per_delivery": 1
  },
  "ui": {
    "animation_interval_ms": 500,
    "animation_foreground_y_offset_px": -100
  }
}
