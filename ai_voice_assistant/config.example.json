{
  "_note": "Copy this file to config.local.json for your own machine. config.local.json is ignored by Git. For optional BlueMagpie TTS setup, see docs/bluemagpie_tts_setup.md.",
  "pipeline_v2_5": {
    "metrics_enabled": true,
    "revision_aware_endpoint": true,
    "progressive_transcription": false,
    "streaming_tts": false,
    "adaptive_chunking": false,
    "parallel_speaker": false,
    "playback_queue_chunks": 128,
    "tts_queue_chunks": 8,
    "streaming_decode_min_bytes": 1440,
    "tts_first_chunk_min_chars": 12,
    "tts_chunk_min_chars": 20,
    "tts_chunk_max_chars": 80,
    "speaker_join_timeout_seconds": 15
  },
  "whisper": {
    "backend": "local",
    "model_size": "small",
    "device": "cpu",
    "compute_type": "int8",
    "language": "zh",
    "groq": {
      "api_key": "",
      "api_key_env": "GROQ_API_KEY",
      "model": "whisper-large-v3",
      "api_url": "https://api.groq.com/openai/v1/audio/transcriptions",
      "timeout_seconds": 30,
      "confidence_gate": {
        "enabled": true,
        "avg_logprob_threshold": -1.0,
        "no_speech_prob_threshold": 0.9,
        "temperature_threshold": 0.0,
        "min_transcript_similarity": 0.5
      }
    }
  },
  "tts": {
    "backend": "edge",
    "voice": "zh-TW-HsiaoChenNeural",
    "rate": "+0%",
    "volume": "+0%",
    "bluemagpie": {
      "enabled": false,
      "mode": "worker",
      "worker_python": ".venv-bluemagpie/Scripts/python.exe",
      "worker_script": "tools/bluemagpie_tts_worker.py",
      "model_dir": "models/bluemagpie",
      "hf_repo": "OpenFormosa/BlueMagpie-TTS",
      "hf_token_env": "HF_TOKEN",
      "device": "cuda",
      "cfg_value": 2.8,
      "inference_timesteps": 9,
      "max_len": 2000,
      "retry_badcase": true,
      "seed": null,
      "fade_out_ms": 30,
      "tail_silence_ms": 220,
      "speaker_centroid_path": "",
      "prompt_text": "",
      "prompt_wav_path": "",
      "seed_retry_count": 5,
      "min_rms": 0.0005,
      "min_nonzero_ratio": 0.001,
      "warm_on_start": false,
      "request_timeout_seconds": 120,
      "output_sample_rate": 24000,
      "temp_dir": "logs/tts_tmp"
    }
  },
  "llm": {
    "active_backend": "antigravity_cli",
    "codex_cli": {
      "project_dir": "./agent_workspace",
      "sandbox": "danger-full-access",
      "approval_policy": "never",
      "request_timeout_seconds": 30
    },
    "opencode_cli": {
      "project_dir": "./agent_workspace",
      "model": "",
      "permission_mode": "yolo",
      "enable_web_search": true,
      "required_context_files": [
        "AGENTS.md"
      ],
      "instruction_files": [
        "MEMORY.md"
      ]
    },
    "grok_cli": {
      "project_dir": "./agent_workspace",
      "model": "",
      "reasoning_effort": "",
      "auth_method": "auto",
      "auto_approve": true,
      "auto_approve_scope": "once",
      "enable_web_search": true,
      "enable_subagents": false,
      "load_private_context": true,
      "required_context_files": [
        "AGENTS.md"
      ],
      "instruction_files": [
        "MEMORY.md"
      ]
    },
    "claude_code": {
      "project_dir": "./agent_workspace",
      "permission_mode": ""
    },
    "antigravity_cli": {
      "project_dir": "./agent_workspace",
      "print_timeout": ""
    }
  },
  "whisper_audio_archive": {
    "enabled": false,
    "write_transcript_sidecar": false
  },
  "speaker_recognition": {
    "enabled": false,
    "profile_dir": "voice_profiles",
    "threshold": 0.83,
    "min_duration_seconds": 2.0,
    "min_score_margin": 0.013
  },
  "heartbeat": {
    "enabled": false,
    "interval_minutes": 20
  },
  "whiteboard": {
    "enabled": true,
    "state_dir": "whiteboard_state",
    "tool_path": "agent_workspace/tools/whiteboard_tool.py",
    "tool_payload_dir": "agent_workspace/tool_payloads/whiteboard",
    "poll_interval_ms": 500,
    "max_markdown_bytes": 200000,
    "max_image_bytes": 10485760,
    "max_image_pixels": 16000000,
    "markdown_renderer": "ctk_markdown",
    "allow_markdown_links": false,
    "allow_markdown_images": false,
    "allow_raw_html": false
  },
  "ui": {
    "animation_foreground_y_offset_px": -100,
    "fullscreen_exit_shortcuts": [
      "ESC",
      "F11"
    ],
    "fullscreen_enter_shortcuts": [
      "F11"
    ]
  }
}
