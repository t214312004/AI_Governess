{
  "_note": "Copy this file to config.local.json for your own machine. config.local.json is ignored by Git.",
  "whisper": {
    "backend": "local",
    "model_size": "small",
    "device": "cpu",
    "compute_type": "int8",
    "language": "zh",
    "groq": {
      "api_key": "",
      "api_key_env": "GROQ_API_KEY",
      "model": "whisper-large-v3",
      "api_url": "https://api.groq.com/openai/v1/audio/transcriptions",
      "timeout_seconds": 30
    }
  },
  "llm": {
    "active_backend": "gemini_cli",
    "openclaw": {
      "api_url": "http://localhost:18789/v1/responses",
      "token": "",
      "agent_id": ""
    },
    "codex_cli": {
      "project_dir": "./agent_workspace",
      "sandbox": "workspace-write",
      "approval_policy": "on-request"
    },
    "gemini_cli": {
      "project_dir": "./agent_workspace"
    },
    "opencode_cli": {
      "project_dir": "./agent_workspace",
      "model": "",
      "permission_mode": "yolo",
      "enable_web_search": true,
      "required_context_files": [
        "AGENTS.md"
      ],
      "instruction_files": [
        "MEMORY.md"
      ]
    },
    "claude_code": {
      "project_dir": "./agent_workspace",
      "permission_mode": ""
    },
    "antigravity_cli": {
      "project_dir": "./agent_workspace",
      "print_timeout": ""
    }
  },
  "whisper_audio_archive": {
    "enabled": false,
    "write_transcript_sidecar": false
  },
  "speaker_recognition": {
    "enabled": false,
    "profile_dir": "voice_profiles"
  },
  "heartbeat": {
    "enabled": false,
    "interval_minutes": 20
  },
  "ui": {
    "animation_foreground_y_offset_px": -100
  }
}
